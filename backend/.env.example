# Copy to .env and fill in. Never commit the real .env file.
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Firebase service account: paste the whole JSON on one line (Vercel) OR give a file path (local)
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# Comma separated emails allowed to approve payments
ADMIN_EMAILS=you@example.com

# Comma separated frontend addresses allowed to call this API
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-project.web.app

# Local testing only: skips login and uses an in-memory database. NEVER true in production.
AUTH_DISABLED=false
